# PostgreSQL (Neon, Supabase or Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/chiledao?sslmode=require"

# Safe local/demo fallback. Set to false in production after configuring auth.
DEMO_MODE="true"
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional OAuth adapter configuration
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional EVM attestation provider. Mock is used when omitted.
ATTESTATION_PROVIDER="mock"
EVM_CHAIN_ID="8453"
EVM_RPC_URL=""
EAS_CONTRACT_ADDRESS=""
EAS_MEMBERSHIP_SCHEMA_UID=""
EAS_CONTRIBUTION_SCHEMA_UID=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
