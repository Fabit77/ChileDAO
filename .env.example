# Supabase PostgreSQL (Transaction pooler recommended for Vercel)
DATABASE_URL="postgresql://user:password@host:5432/chiledao?sslmode=require"

# Supabase Auth public browser credentials. Never expose service_role.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Exact GitHub usernames verified by Supabase Auth that bootstrap as SUPER_ADMIN.
SUPERADMIN_GITHUB_USERNAMES="your-github-handle"

# Optional EVM attestation provider. Mock is used when omitted.
ATTESTATION_PROVIDER="mock"
EVM_CHAIN_ID="8453"
EVM_RPC_URL=""
EAS_CONTRACT_ADDRESS=""
EAS_MEMBERSHIP_SCHEMA_UID=""
EAS_CONTRIBUTION_SCHEMA_UID=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
